{
  "Urls": "http://localhost:5000",
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "docs": {
        "ClusterId": "monolith",
        "Order": -10,
        "Match": {
          "Path": "/api/docs"
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "openapi-root": {
        "ClusterId": "monolith",
        "Order": -10,
        "Match": {
          "Path": "/openapi"
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "openapi": {
        "ClusterId": "monolith",
        "Match": {
          "Path": "/openapi/{**catch-all}"
        }
      },
      "api": {
        "ClusterId": "monolith",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "monolith": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:5080/"
          }
        }
      }
    }
  },
  "App": {
    "CustomerUrl": "http://localhost:5173",
    "VendorUrl": "http://localhost:5173",
    "AdminUrl": "http://localhost:5173"
  },
  "AllowedHosts": "*"
}
