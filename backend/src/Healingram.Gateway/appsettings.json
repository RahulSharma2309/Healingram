{
  "Urls": "http://localhost:5000",
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "monolith",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "monolith": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:5080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
